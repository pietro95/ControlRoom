          "rawSql": "SELECT coalesce(acquedotto, '—') AS \"Acquedotto\", count(*) AS \"Alert\", count(*) FILTER (WHERE is_repeat) AS \"di cui ripetuti\" FROM v_alert WHERE $__timeFilter(opened_at) AND coalesce(acquedotto, '—') IN ($acquedotto) AND reparto IN ($reparto) GROUP BY 1 ORDER BY 2 DESC",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "orientation": "auto",
        "showValue": "auto",
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "xTickLabelRotation": -45
      },
      "id": 8
    },
    {
