          },
          "rawSql": "SELECT reparto AS \"Reparto\", count(*) AS \"Alert\" FROM v_alert WHERE $__timeFilter(opened_at) AND coalesce(acquedotto, '—') IN ($acquedotto) AND reparto IN ($reparto) GROUP BY 1 ORDER BY 2 DESC",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "orientation": "auto",
