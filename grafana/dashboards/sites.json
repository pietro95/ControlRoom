          }
        },
        "overrides": []
      },
      "options": {
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/"
        }
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "Ultima sincronizzazione riuscita",
      "description": "I grafici mostrano i dati fino a questo momento. Se GLPI non risponde il valore smette di avanzare.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "reporting"
      },
      "gridPos": {
        "x": 10,
        "y": 0,
        "w": 7,
        "h": 3
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "reporting"
          },
          "rawSql": "SELECT extract(epoch FROM last_success_at) * 1000 AS \"Ultima sync\" FROM v_sync_status",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeFromNow"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        }
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "Errore ultimo tentativo",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "reporting"
      },
      "gridPos": {
        "x": 17,
        "y": 0,
        "w": 7,
        "h": 3
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "reporting"
          },
          "rawSql": "SELECT coalesce(last_error, 'nessuno') AS \"Errore\" FROM v_sync_status",
          "format": "table",
          "rawQuery": true,
