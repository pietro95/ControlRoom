{
  "uid": "cr-calls",
  "title": "Control Room – Chiamate dal campo",
  "tags": [
    "controlroom"
  ],
  "timezone": "Europe/Rome",
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
