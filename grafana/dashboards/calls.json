  "templating": {
    "list": [
      {
        "name": "acquedotto",
        "label": "Acquedotto",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "reporting"
        },
        "query": "SELECT DISTINCT coalesce(acquedotto, '—') FROM v_alert ORDER BY 1",
        "definition": "SELECT DISTINCT coalesce(acquedotto, '—') FROM v_alert ORDER BY 1",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Fonte dati",
      "description": "'GLPI' in produzione. Se compare SINTETICO i numeri sono generati da scripts/gen_synthetic.py.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "reporting"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 10,
        "h": 3
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "reporting"
          },
          "rawSql": "SELECT dataset_label AS \"Fonte\" FROM v_sync_status",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          }
        },
        "overrides": []
      },
      "options": {
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/"
        }
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "Ultima sincronizzazione riuscita",
      "description": "I grafici mostrano i dati fino a questo momento. Se GLPI non risponde il valore smette di avanzare.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "reporting"
      },
      "gridPos": {
        "x": 10,
        "y": 0,
        "w": 7,
        "h": 3
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "reporting"
          },
          "rawSql": "SELECT extract(epoch FROM last_success_at) * 1000 AS \"Ultima sync\" FROM v_sync_status",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeFromNow"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        }
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "Errore ultimo tentativo",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "reporting"
      },
      "gridPos": {
        "x": 17,
        "y": 0,
        "w": 7,
        "h": 3
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "reporting"
          },
          "rawSql": "SELECT coalesce(last_error, 'nessuno') AS \"Errore\" FROM v_sync_status",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "textMode": "value",
        "colorMode": "none",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/"
        }
      },
      "id": 3
    },
    {
      "type": "stat",
      "title": "Chiamate nel periodo",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "reporting"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "reporting"
          },
          "rawSql": "SELECT count(*) AS \"Chiamate\" FROM v_call WHERE $__timeFilter(opened_at) AND coalesce(acquedotto, '—') IN ($acquedotto)",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "graphMode": "none",
        "colorMode": "none"
      },
      "id": 4
    },
    {
      "type": "stat",
      "title": "Tempo di gestione mediano",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "reporting"
      },
      "gridPos": {
        "x": 8,
        "y": 3,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "reporting"
          },
          "rawSql": "SELECT percentile_cont(0.5) WITHIN GROUP (ORDER BY ttr_min) AS \"Mediana\" FROM v_call WHERE ttr_min IS NOT NULL AND $__timeFilter(opened_at) AND coalesce(acquedotto, '—') IN ($acquedotto)",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "m"
        },
        "overrides": []
      },
      "options": {
        "graphMode": "none",
        "colorMode": "none"
      },
      "id": 5
    },
    {
      "type": "stat",
      "title": "Aperte ora",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "reporting"
      },
      "gridPos": {
        "x": 16,
        "y": 3,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "reporting"
          },
          "rawSql": "SELECT count(*) AS \"Aperte\" FROM v_call WHERE is_open AND coalesce(acquedotto, '—') IN ($acquedotto)",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "graphMode": "none",
        "colorMode": "none"
      },
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Chiamate per settimana",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "reporting"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "reporting"
          },
          "rawSql": "SELECT (date_trunc('week', opened_at AT TIME ZONE 'Europe/Rome') AT TIME ZONE 'Europe/Rome') AS time, count(*) AS \"Chiamate\" FROM v_call WHERE $__timeFilter(opened_at) AND coalesce(acquedotto, '—') IN ($acquedotto) GROUP BY 1 ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {},
      "id": 7
    },
    {
      "type": "table",
      "title": "Chiamate per sito",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "reporting"
      },
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "reporting"
          },
          "rawSql": "SELECT coalesce(site_code, '—') AS \"Sito\", count(*) AS \"Chiamate\", percentile_cont(0.5) WITHIN GROUP (ORDER BY ttr_min) AS \"Mediana (min)\", max(opened_at) AS \"Ultima\" FROM v_call WHERE $__timeFilter(opened_at) AND coalesce(acquedotto, '—') IN ($acquedotto) GROUP BY 1 ORDER BY 2 DESC",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      },
      "options": {},
      "id": 8
    }
