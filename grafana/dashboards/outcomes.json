            "type": "grafana-postgresql-datasource",
            "uid": "reporting"
          },
          "rawSql": "SELECT avg((outcome = 'Non classificato')::int) AS \"Non classificati\" FROM v_alert WHERE $__timeFilter(opened_at) AND coalesce(acquedotto, '—') IN ($acquedotto) AND NOT is_open",
