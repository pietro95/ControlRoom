    {
      "type": "table",
      "title": "Esiti per operatore (solo chiusure tracciate dall'app)",
      "description": "Operatore dall'audit dell'app o dalla riga nel testo della soluzione. 'Ultima modifica di' di GLPI non è usato.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "reporting"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
