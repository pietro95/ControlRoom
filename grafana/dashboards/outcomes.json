          "rawSql": "SELECT (date_trunc('week', opened_local) AT TIME ZONE 'Europe/Rome') AS time, outcome AS metric, count(*) AS value FROM v_alert WHERE $__timeFilter(opened_at) AND coalesce(acquedotto, '—') IN ($acquedotto) AND NOT is_open GROUP BY 1, 2 ORDER BY 1",
