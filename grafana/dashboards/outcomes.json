      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "reporting"
          },
          "rawSql": "SELECT handled_by AS \"Operatore\", count(*) AS \"Alert\", count(*) FILTER (WHERE outcome = 'Rientrato') AS \"Rientrato\", count(*) FILTER (WHERE outcome = 'Manovra') AS \"Manovra\", count(*) FILTER (WHERE outcome = 'Altro') AS \"Altro\" FROM v_alert WHERE $__timeFilter(opened_at) AND coalesce(acquedotto, '—') IN ($acquedotto) AND handled_by <> 'sconosciuto' GROUP BY 1 ORDER BY 2 DESC",
