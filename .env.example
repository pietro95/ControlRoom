# --- GLPI (account di servizio dedicato, profilo limitato all'entità Control Room) ---
GLPI_URL=https://glpi.siciliacque.it
GLPI_APP_TOKEN=
GLPI_USER_TOKEN=
GLPI_ENTITY_ID=14
GLPI_REQUESTTYPE_PHONE=8
GLPI_SOLTYPE_RIENTRATO=1
GLPI_SOLTYPE_MANOVRA=2
GLPI_SOLTYPE_ALTRO=3

# --- Active Directory ---
LDAP_URL=ldaps://dc.siciliacque.local
# Certificato della CA interna che firma il DC (lo stesso di gestione-contratti). Sul server:
#   /appdata/controlroom/config/certs/ca-interna.pem, montato nel container qui. Se manca, l'app non parte.
LDAP_CA_CERT_FILE=/etc/controlroom/certs/ca-interna.pem
# LDAP_VALIDATE_TLS=false disattiva la verifica del certificato del DC: VIETATO in produzione (deploy.sh si ferma).
LDAP_DOMAIN=siciliacque.local
LDAP_BASE_DN=DC=siciliacque,DC=local
# Ruoli dai gruppi AD (DN completi). Chi non è in nessuno dei due gruppi non entra.
# operatore = coda alert + nuova chiamata (scrive su GLPI); manager = Statistiche, sola lettura.
LDAP_OPERATOR_GROUP_DN=CN=ControlRoom-Operatori,OU=Gruppi,DC=siciliacque,DC=local
LDAP_MANAGER_GROUP_DN=CN=ControlRoom-Manager,OU=Gruppi,DC=siciliacque,DC=local
# true = conta anche i gruppi annidati (LDAP_MATCHING_RULE_IN_CHAIN, solo Active Directory)
LDAP_NESTED_GROUPS=true

# --- App ---
# Indirizzo e porta su cui il portale è pubblicato sull'host (unico servizio esposto).
# Server condiviso: porta libera e non standard. Con Nginx Proxy Manager in un container, APP_BIND è l'IP con cui
# quel container raggiunge l'host (di solito il gateway del bridge, 172.17.0.1), non 127.0.0.1.
APP_BIND=127.0.0.1
APP_PORT=18480
SESSION_SECRET=            # openssl rand -hex 32
COOKIE_SECURE=true
REFRESH_SECONDS=15
FLAPPING_THRESHOLD=3

# --- Reporting (Postgres + Grafana, rete interna del compose) ---
# URL pubblico del portale (come lo apre il browser, senza / finale): Grafana è servito sotto <questo>/grafana/
PORTAL_PUBLIC_URL=https://controlroom.siciliacque.local
POSTGRES_PASSWORD=          # superuser, solo amministrazione
SYNC_DB_PASSWORD=           # utente cr_sync (scrive lo schema reporting). Solo [A-Za-z0-9]: finisce in un URL
GRAFANA_DB_PASSWORD=        # utente grafana_ro (solo SELECT)
GRAFANA_ADMIN_USER=cr-grafana-admin   # NON deve coincidere con un account AD
GRAFANA_ADMIN_PASSWORD=

# --- Worker di sync GLPI -> Postgres ---
SYNC_INTERVAL_SECONDS=60
SYNC_OVERLAP_SECONDS=300       # ogni giro rilegge gli ultimi 5 minuti (upsert idempotente)
SYNC_RECONCILE_HOURS=24        # ricerca di tutti gli ID per marcare i ticket cancellati in GLPI
FLAPPING_WINDOW_MIN=60         # KPI "ripetizione": alert sullo stesso sito entro N minuti dal precedente
MASS_CLOSURE_MINUTES=2026-08-20 17:42   # minuti (ora di Roma) di chiusure massive da escludere, separati da virgola
# Search option GLPI (Ticket): verificare con GET /apirest.php/listSearchOptions/Ticket prima del primo avvio
GLPI_SO_TITLE=1
GLPI_SO_ID=2
GLPI_SO_REQUESTTYPE=9
GLPI_SO_STATUS=12
GLPI_SO_DATE=15
GLPI_SO_CLOSEDATE=16
GLPI_SO_SOLVEDATE=17
GLPI_SO_DATE_MOD=19
GLPI_SO_SOLUTIONTYPE=23
GLPI_SO_SOLUTION=24
GLPI_SO_ENTITY=80
GLPI_SO_LOCATION=83
