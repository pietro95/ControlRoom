# --- GLPI (account di servizio dedicato, profilo limitato all'entità Control Room) ---
GLPI_URL=https://glpi.siciliacque.it
GLPI_APP_TOKEN=
GLPI_USER_TOKEN=
GLPI_ENTITY_ID=14
GLPI_REQUESTTYPE_PHONE=8
GLPI_SOLTYPE_RIENTRATO=1
GLPI_SOLTYPE_MANOVRA=2
GLPI_SOLTYPE_ALTRO=3

# --- Active Directory ---
LDAP_URL=ldaps://dc.siciliacque.local
LDAP_DOMAIN=siciliacque.local
LDAP_BASE_DN=DC=siciliacque,DC=local
# Ruoli dai gruppi AD (DN completi). Chi non è in nessuno dei due gruppi non entra.
# operatore = coda alert + nuova chiamata (scrive su GLPI); manager = Statistiche, sola lettura.
LDAP_OPERATOR_GROUP_DN=CN=ControlRoom-Operatori,OU=Gruppi,DC=siciliacque,DC=local
LDAP_MANAGER_GROUP_DN=CN=ControlRoom-Manager,OU=Gruppi,DC=siciliacque,DC=local
# true = conta anche i gruppi annidati (LDAP_MATCHING_RULE_IN_CHAIN, solo Active Directory)
LDAP_NESTED_GROUPS=true

# --- App ---
SESSION_SECRET=            # openssl rand -hex 32
COOKIE_SECURE=true
REFRESH_SECONDS=15
FLAPPING_THRESHOLD=3

# --- Reporting (Postgres + Grafana, rete interna del compose) ---
# URL pubblico del portale (come lo apre il browser, senza / finale): Grafana è servito sotto <questo>/grafana/
PORTAL_PUBLIC_URL=https://controlroom.siciliacque.local
POSTGRES_PASSWORD=          # superuser, solo amministrazione
SYNC_DB_PASSWORD=           # utente cr_sync (scrive lo schema reporting)
GRAFANA_DB_PASSWORD=        # utente grafana_ro (solo SELECT)
GRAFANA_ADMIN_USER=cr-grafana-admin   # NON deve coincidere con un account AD
GRAFANA_ADMIN_PASSWORD=
